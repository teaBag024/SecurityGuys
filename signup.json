{
  "formId": "user_signup_form",
  "title": "Create Your Account",
  "submitEndpoint": "/api/v1/auth/signup",
  "method": "POST",
  "fields": [
    {
      "name": "email",
      "label": "Email Address",
      "type": "email",
      "placeholder": "name@example.com",
      "required": true,
      "validation": {
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
        "message": "Please enter a valid email address."
      }
    },
    {
      "name": "firstName",
      "label": "First Name",
      "type": "text",
      "placeholder": "Enter your first name",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 50,
        "message": "First name must be between 2 and 50 characters."
      }
    },
    {
      "name": "lastName",
      "label": "Last Name",
      "type": "text",
      "placeholder": "Enter your last name",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 50,
        "message": "Last name must be between 2 and 50 characters."
      }
    },
    {
      "name": "address",
      "label": "Street Address",
      "type": "text",
      "placeholder": "12345 Drive Street",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 1000,
        "message": "Please enter the street address you live at."
      }
    },
    {
      "name": "state",
      "label": "State",
      "type": "text",
      "placeholder": "Enter your state",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 1000,
        "message": "Please enter the state you live in."
      }
    },
    {
      "name": "city",
      "label": "City",
      "type": "text",
      "placeholder": "Enter your city",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 1000,
        "message": "Please enter the city you live in."
      }
    },
    {
      "name": "zipcode",
      "label": "Zip Code",
      "type": "text",
      "placeholder": "Enter your Zip Code",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 1000,
        "message": "Please enter your zip code."
      }
    },
    {
      "name": "ssn",
      "label": "Social Security Number",
      "type": "text",
      "placeholder": "Enter your Social Security Number",
      "required": true,
      "validation": {
        "minLength": 8,
        "message": "Please enter social security number."
      }
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "placeholder": "Create a strong password",
      "required": true,
      "validation": {
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*?&]{8,}$",
        "message": "Password must be at least 8 characters and include a letter and a number."
      }
    },
    {
      
    },
    {
      "name": "termsAccepted",
      "label": "I agree to the Terms of Service and Privacy Policy",
      "type": "checkbox",
      "required": true,
      "default": true,
      "defaultValue": true,
      "validation": {
        "mustBeTrue": true,
        "message": "You must accept the terms to continue."
      }
    },
    {
      "name": "subscribetoNewsletter",
      "label": "Subscribe to our news letter!!",
      "type": "checkbox",
      "required": true,
      "default": true,
      "defaultValue": true
    }
    


  ],
  "submitButton": {
    "text": "Sign Up",
    "loadingText": "Creating Account..."
  }
}
